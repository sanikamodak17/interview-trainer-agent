          "template": {
            "code": {
              "display_name": "Aggregator Function",
              "type": "code",
              "value": "def aggregate_responses(mode: str, questions_response: str = '', eval_response: str = '', strategy_response: str = '') -> str:\n    \"\"\"Combine active agent responses into a single final message.\"\"\"\n    if mode == 'generate':\n        return questions_response\n    elif mode == 'evaluate':\n        return eval_response\n    elif mode == 'strategy':\n        return strategy_response\n    elif mode == 'full':\n        sep = '\\n\\n' + '='*60 + '\\n\\n'\n        parts = [p for p in [questions_response, strategy_response] if p]\n        return sep.join(parts)\n    return questions_response or eval_response or strategy_response",
              "show": false
            },
            "mode": {
              "display_name": "Active Mode",
              "type": "str",
              "value": "generate",
              "show": true
            }
          },
