            "code": {
              "display_name": "IAM Token Function",
              "type": "code",
              "value": "import requests\ndef get_iam_token(api_key: str, iam_url: str) -> str:\n    \"\"\"Exchange an IBM Cloud API key for a bearer token.\"\"\"\n    resp = requests.post(\n        iam_url,\n        headers={'Content-Type': 'application/x-www-form-urlencoded'},\n        data=f'grant_type=urn:ibm:params:oauth:grant-type:apikey&apikey={api_key}',\n        timeout=30\n    )\n    resp.raise_for_status()\n    return resp.json()['access_token']",
              "show": false
            }
          },
          "display_name": "IBM IAM Auth",
          "description": "Exchanges the IBM Cloud API key for a short-lived IAM bearer token. Output is injected into all Granite LLM nodes.",
          "base_classes": ["Tool"],
          "outputs": [
            { "name": "token", "display_name": "Bearer Token", "types": ["str"] }
          ],
          "documentation": "https://cloud.ibm.com/docs/account?topic=account-iamtoken_from_apikey",
          "icon": "lock",
          "category": "tools"
        }
      }
    },

    {
      "id": "kb-retriever",
      "type": "PythonFunctionTool",
      "position": { "x": 60, "y": 600 },
      "data": {
        "id": "kb-retriever",
        "type": "PythonFunctionTool",
        "node": {
          "template": {
            "kb_path": {
              "display_name": "Knowledge Base Path",
              "info": "Path to the interview knowledge base markdown file",
              "required": true,
              "type": "str",
              "value": "interview_trainer_agent/knowledge_base/interview_knowledge_base.md",
              "show": true
            },
            "embeddings_model": {
              "display_name": "Embeddings Model",
              "type": "str",
              "value": "ibm/slate-125m-english-rtrvr-v2",
              "show": true
            },
            "top_k": {
              "display_name": "Top K Sections",
              "type": "int",
              "value": 6,
              "show": true
            },
            "code": {
              "display_name": "RAG Retriever Function",
              "type": "code",
              "value": "def retrieve_context(kb_path: str, job_role: str, experience_level: str, top_k: int = 6) -> str:\n    \"\"\"Retrieve relevant KB sections by keyword matching (Milvus+Slate in production).\"\"\"\n    with open(kb_path, 'r') as f:\n        content = f.read()\n    sections = content.split('###')\n    keywords = [job_role.lower(), experience_level, 'behavioral', 'star method', 'hr guidelines', 'soft skill']\n    ranked = sorted(sections, key=lambda s: sum(1 for kw in keywords if kw in s.lower()), reverse=True)\n    return '\\n\\n'.join(s.strip() for s in ranked[:top_k] if s.strip())",
              "show": false
            }
          },
          "display_name": "RAG Knowledge Retriever",
          "description": "Retrieves role- and level-matched sections from the interview knowledge base. Uses keyword scoring locally; uses Milvus + ibm/slate-125m-english-rtrvr-v2 embeddings in the watsonx Orchestrate production deployment.",
          "base_classes": ["Tool"],
          "outputs": [
            { "name": "context", "display_name": "Retrieved Context", "types": ["str"] }
          ],
          "documentation": "https://docs.langflow.org/components/data",
          "icon": "database",
          "category": "tools"
        }
      }
    },

    {
